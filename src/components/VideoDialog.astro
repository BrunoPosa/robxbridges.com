---
// One viewer for videos that open over the page.
// Any button with data-dialog-src opens it:
//   data-dialog-src    the embed address (YouTube or Instagram)
//   data-dialog-title  words for screen readers
//   data-dialog-link   optional, the page to open the video on its own site
//   data-dialog-shape  "wide" for YouTube, "tall" for Instagram
// Closing the viewer removes the player, so the sound stops.
---

<dialog class="video-dialog" aria-label="Video">
  <div class="video-dialog-frame"></div>
  <div class="video-dialog-bar">
    <a class="video-dialog-link" target="_blank" rel="noopener noreferrer" hidden></a>
    <button type="button" class="video-dialog-close">
      Close
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".video-dialog");
  const holder = dialog?.querySelector<HTMLElement>(".video-dialog-frame");
  const link = dialog?.querySelector<HTMLAnchorElement>(".video-dialog-link");

  function open(trigger: HTMLElement): void {
    const src = trigger.dataset.dialogSrc;
    if (!dialog || !holder || !src) return;
    const frame = document.createElement("iframe");
    frame.src = src;
    frame.title = trigger.dataset.dialogTitle ?? "Video";
    frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    frame.allowFullscreen = true;
    holder.replaceChildren(frame);
    dialog.dataset.shape = trigger.dataset.dialogShape ?? "wide";
    dialog.setAttribute("aria-label", frame.title);
    if (link) {
      const href = trigger.dataset.dialogLink ?? "";
      link.hidden = !href;
      link.href = href;
      link.textContent = href.includes("instagram.com") ? "Instagram" : "YouTube";
    }
    dialog.showModal();
  }

  // Buttons can be added later (the music page swaps them per release),
  // so one listener on the page handles them all.
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const trigger = target?.closest<HTMLElement>("[data-dialog-src]");
    if (trigger) open(trigger);
  });

  dialog?.querySelector(".video-dialog-close")?.addEventListener("click", () => {
    dialog.close();
  });
  // A click on the dark space around the video closes it.
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => holder?.replaceChildren());
</script>
