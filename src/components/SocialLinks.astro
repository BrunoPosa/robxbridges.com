---
interface Link {
  label: string;
  href: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

{links.length > 0 && (
  <ul class="socials">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label === "YouTube" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="6.5" width="18" height="11" rx="2.5" />
              <path d="M11 10.2v3.6l3.4-1.8z" fill="currentColor" stroke="none" />
            </svg>
          )}
          {link.label === "Instagram" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="16" height="16" rx="4" />
              <circle cx="12" cy="12" r="3.4" />
              <circle cx="16.8" cy="7.2" r="0.7" fill="currentColor" stroke="none" />
            </svg>
          )}
          {link.label === "Bandcamp" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8" />
              <path
                d="M9.2 15.2 13.2 8.8h1.6l-4 6.4z"
                fill="currentColor"
                stroke="none"
              />
            </svg>
          )}
          {link.label === "Spotify" && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8" />
              <path d="M8 10.4c2.6-1 5.6-.9 8.1.4M8.3 13c2.2-.8 4.7-.7 6.9.4M8.7 15.5c1.8-.6 3.7-.5 5.4.4" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .socials {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
  }

  a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--taupe);
  }

  a:hover {
    color: var(--bone);
  }

  svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
</style>
