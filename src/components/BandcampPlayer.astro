---
// Bandcamp's own player for one release or track, with everything around it:
// a gray outline while it loads, a "Listen on Bandcamp" link if it never
// loads, and a gray "Not available" panel when Bandcamp has removed it.
// The page script that runs it is src/scripts/bandcamp-player.ts.
//
// Use it with a PlayerView from src/data/bandcamp.ts:
//   <BandcampPlayer view={await playerView(album.player)} />
import type { PlayerView } from "../data/bandcamp";

type Props = {
  view: PlayerView;
  // "lazy" waits to load the player until it is near the screen.
  loading?: "eager" | "lazy";
  // Extra classes for the page's own spacing.
  class?: string;
};

const { view, loading = "eager", class: className } = Astro.props;
---

<!-- data-state is loading, ready, error, or gone. The page script sets it.
     data-first: a fresh player starts blank, so the outline covers all of it.
     src/scripts/bandcamp-player.ts removes it when the player changes release. -->
<div
  class:list={["player-frame", className]}
  data-state={view.gone ? "gone" : "loading"}
  data-rows={view.rows}
  data-first
>
  <div class="player-skeleton" aria-hidden="true">
    <div class="skeleton-top">
      <span class="skeleton-play"></span>
      <span class="skeleton-lines">
        <span></span>
        <span></span>
        <span class="skeleton-timeline"></span>
      </span>
    </div>
    <div class="skeleton-rows">
      {Array.from({ length: view.rows }, () => (
        <span class="skeleton-row" />
      ))}
    </div>
  </div>
  <!-- Shown instead of the player when Bandcamp has removed it. -->
  <p class="player-gone">Not available right now :(</p>
  <p class="player-error">
    The player did not load.
    <a href={view.url} target="_blank" rel="noopener noreferrer">
      Listen on Bandcamp
    </a>
  </p>
  {!view.gone && (
    // With JavaScript off, Bandcamp's player stays a white box, so offer
    // its own page instead.
    <noscript>
      <p class="player-error player-noscript">
        The player needs JavaScript.
        <a href={view.url} target="_blank" rel="noopener noreferrer">
          Listen on Bandcamp
        </a>
      </p>
    </noscript>
  )}
  <script is:inline>
    // Bandcamp says "playerinited" once its player is drawn, which can be
    // before the page script starts. This listens from the first player on
    // the page and lifts the outline of whichever player said it.
    if (!window.bandcampListening) {
      window.bandcampListening = true;
      addEventListener("message", (event) => {
        if (event.origin !== "https://bandcamp.com" || event.data !== "playerinited") {
          return;
        }
        for (const frame of document.querySelectorAll(".player-frame iframe")) {
          const box = frame.parentElement;
          if (frame.contentWindow === event.source && box.dataset.state === "loading") {
            box.dataset.state = "ready";
          }
        }
      });
    }
  </script>
  <iframe
    class="player"
    title={`${view.title} on Bandcamp`}
    src={view.gone ? "about:blank" : view.src}
    height={view.height}
    style={`height:${view.height}px`}
    loading={loading}
    allow="autoplay; encrypted-media"
  ></iframe>
</div>

<script>
  import "../scripts/bandcamp-player";
</script>

<!-- Global, because the page script adds outline rows that a scoped style
     would not reach. Every class here starts with player- or skeleton-. -->
<style is:global>
  /* Bandcamp paints this gray itself. The frame matches it, so the corners
     and any spare pixels read as one card. */
  .player-frame {
    position: relative;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
    border: 1px solid rgba(236, 231, 220, 0.16);
    border-radius: 14px;
    background: #303030;
    line-height: 0;
  }

  .player {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    border: 0;
    background: #303030;
    overscroll-behavior: contain;
  }

  .player-skeleton,
  .player-error {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* While Bandcamp loads, a dark outline of its track list covers that part
     of the player, at the same size, so it never flashes white. The top part
     of the player (120px: play button, timeline) stays uncovered, except on a
     fresh player (data-first), which starts blank too. */
  .player-skeleton {
    top: 120px;
    overflow: hidden;
    background: #303030;
  }

  .player-frame[data-first] .player-skeleton {
    top: 0;
  }

  /* The outline of the player's top part: a round play button, two lines of
     text, and a timeline. */
  .skeleton-top {
    display: none;
    align-items: center;
    gap: 1rem;
    height: 120px;
    padding: 0 1.1rem;
  }

  .player-frame[data-first] .skeleton-top {
    display: flex;
  }

  /* It appears at once, so the old list never shows through, and fades out
     once the new list is ready. */
  .player-frame:not([data-state="loading"]) .player-skeleton,
  .player-frame[data-rows="0"]:not([data-first]) .player-skeleton {
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  /* Safety net: the placeholder fades out on its own after 8 seconds, even if
     the page script never lifts it, so it can never block a player for good.
     It restarts each time a player starts loading. */
  .player-frame[data-state="loading"] .player-skeleton {
    animation: skeleton-give-up 350ms ease 8s forwards;
  }

  @keyframes skeleton-give-up {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* A soft band of light that drifts across, to say "loading". */
  .player-skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgba(236, 231, 220, 0.05) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    animation: skeleton-sweep 1.8s ease-in-out infinite;
  }

  @keyframes skeleton-sweep {
    to {
      transform: translateX(100%);
    }
  }

  .skeleton-row::before {
    display: block;
    border-radius: 2px;
    background: rgba(236, 231, 220, 0.08);
  }

  .skeleton-rows {
    padding: 0.5rem 0.75rem;
  }

  .skeleton-row {
    display: flex;
    align-items: center;
    height: 33px;
    border-bottom: 1px solid rgba(236, 231, 220, 0.04);
  }

  .skeleton-row::before {
    content: "";
    width: 55%;
    height: 0.5rem;
  }

  .skeleton-row:nth-child(even)::before {
    width: 40%;
  }

  /* If Bandcamp never answers, offer its own page instead. */
  .player-error {
    display: none;
    place-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 1.5rem;
    background: #303030;
    color: var(--taupe);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: center;
  }

  .player-error a {
    color: var(--bone);
  }

  .player-frame[data-state="error"] .player-error,
  .player-noscript {
    display: grid;
  }

  /* A release Bandcamp has taken down (found while the site is built): a quiet
     gray panel in place of the player, and no Bandcamp frame at all. */
  .player-gone {
    display: none;
    place-content: center;
    min-height: 120px;
    margin: 0;
    color: var(--taupe);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .player-frame[data-state="gone"] .player-gone {
    display: grid;
  }

  .player-frame[data-state="gone"] .player,
  .player-frame[data-state="gone"] .player-skeleton {
    display: none;
  }

  .skeleton-play {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(236, 231, 220, 0.08);
  }

  .skeleton-lines {
    display: grid;
    flex: 1;
    gap: 0.7rem;
  }

  .skeleton-lines > span {
    display: block;
    width: 45%;
    height: 0.5rem;
    border-radius: 2px;
    background: rgba(236, 231, 220, 0.08);
  }

  .skeleton-lines > span:nth-child(2) {
    width: 30%;
  }

  .skeleton-lines > .skeleton-timeline {
    width: 100%;
    height: 0.3rem;
    margin-top: 0.3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .player-skeleton::after {
      animation: none;
    }

    .player-skeleton {
      transition: none;
    }
  }
</style>
