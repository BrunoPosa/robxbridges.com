---
interface Props {
  name: string;
  overlay?: boolean;
}

const { name, overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/music", label: "Music" },
  { href: "/films", label: "Films" },
  { href: "/collaborations", label: "Collabs" },
  { href: "#about", label: "About" },
];
---

<header class:list={["site-header", { overlay }]}>
  <a class="wordmark" href="/">
    {name}
  </a>
  <nav aria-label="Sections">
    {links.map((link) => (
      <a href={link.href} aria-current={path === link.href ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    min-height: var(--header);
    padding: 1.15rem 8vw 0.9rem;
    background: var(--black);
    border-bottom: 1px solid var(--forest);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--bone);
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem 1.15rem;
  }

  nav a {
    position: relative;
    color: var(--taupe);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.25s ease, opacity 0.25s ease;
  }

  /* A thin line that draws in from the centre on hover. */
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0.16em; /* skip the trailing letter-spacing so the line stays centred */
    bottom: -0.35em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  nav a[aria-current="page"],
  nav a:hover {
    color: var(--bone);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Home page: links sit on the photo, so start them bright with a soft
     shadow for contrast, and dim the others slightly while one is hovered. */
  .site-header.overlay .wordmark,
  .site-header.overlay nav a {
    color: var(--bone);
    text-shadow: 0 1px 8px rgba(8, 7, 6, 0.7);
  }

  .site-header.overlay nav a::after {
    box-shadow: 0 1px 6px rgba(8, 7, 6, 0.6);
  }

  .site-header.overlay nav:hover a:not(:hover) {
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    nav a,
    nav a::after {
      transition: none;
    }
  }

  .site-header.overlay {
    position: absolute;
    inset: 0 0 auto;
    background: transparent;
    border-bottom: none;
    z-index: 4;
  }

  /* The sky in the home still is pale. This fade keeps the links readable. */
  .site-header.overlay::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9rem;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(8, 7, 6, 0.62), rgba(8, 7, 6, 0));
  }

  @media (max-width: 720px) {
    .site-header {
      padding: 1rem 1.25rem 0.85rem;
    }

    nav {
      gap: 0.35rem 0.75rem;
    }

    nav a {
      letter-spacing: 0.12em;
    }

    .wordmark {
      font-size: 1.05rem;
    }
  }
</style>
