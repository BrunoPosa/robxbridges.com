---
// About and contact close every page. The words come from references/links.md.
// Names in [brackets] there become links to that work on the site.
// The contact form mails the Site Email in references/links.md through
// FormSubmit (formsubmit.co), a free service with no account or password.
// The very first message sent makes FormSubmit email that inbox an
// "Activate Form" button. Nothing arrives until it is clicked, once.

import type { Catalog } from "../data/catalog";
import { publicSrc, socialLinks } from "../data/catalog";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  catalog: Catalog;
}

const { catalog } = Astro.props;
const links = socialLinks(catalog);
const paragraphs = catalog.aboutParagraphs;
const year = new Date().getFullYear();
// Where Send posts. The "ajax" one answers the page's script; the plain one
// is the fallback when JavaScript is off, and shows FormSubmit's own thank-you page.
const formAddress = `https://formsubmit.co/${catalog.site.email}`;
const ajaxAddress = `https://formsubmit.co/ajax/${catalog.site.email}`;
---

<footer class="site-footer">
  <div class="inner">
    <section id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      {catalog.aboutPhoto && (
        <img
          src={publicSrc(catalog.aboutPhoto)}
          alt={catalog.site.name}
          width="280"
          height="280"
        />
      )}
      {paragraphs.map((paragraph) => (
        <p class="about-copy">
          {paragraph.map((piece) =>
            !piece.href ? (
              piece.text
            ) : piece.external ? (
              <a href={piece.href} target="_blank" rel="noopener noreferrer">
                {piece.text}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            ) : (
              <a href={piece.href}>{piece.text}</a>
            ),
          )}
        </p>
      ))}
    </section>

    <section id="contact" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <form
        id="contact-form"
        method="post"
        action={formAddress}
        data-endpoint={ajaxAddress}
      >
        <!-- The subject line of the email Rob receives. -->
        <input type="hidden" name="_subject" value="New message from robxbridges.com" />
        <input type="hidden" name="_template" value="table" />
        <!-- A trap for spam bots: people never see it, so it stays empty.
             FormSubmit drops any message where it is filled in. -->
        <input
          class="trap"
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <label>
          Name
          <input name="name" type="text" autocomplete="name" maxlength="200" required />
        </label>
        <label>
          Email
          <input
            name="email"
            type="email"
            autocomplete="email"
            maxlength="200"
            required
          />
        </label>
        <label>
          Message
          <textarea name="message" rows="5" maxlength="5000" required />
        </label>
        <button type="submit">Send</button>
        <p class="form-note" role="status"></p>
      </form>
      <script>
        const form = document.querySelector("#contact-form");
        if (form instanceof HTMLFormElement) {
          const note = form.querySelector(".form-note");
          const button = form.querySelector("button");
          const say = (text: string) => {
            if (note) note.textContent = text;
          };

          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!form.checkValidity() || !button) return;
            button.disabled = true;
            say("Sending…");
            try {
              const response = await fetch(form.dataset.endpoint ?? "", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify(Object.fromEntries(new FormData(form))),
              });
              const answer: { success?: string | boolean } = await response.json();
              if (!response.ok || String(answer.success) !== "true") throw new Error();
              form.reset();
              say("Thank you. Your message is on its way.");
            } catch {
              say("That did not send. Please try again in a moment.");
            } finally {
              button.disabled = false;
            }
          });
        }
      </script>
      <SocialLinks links={links} />
    </section>

    <p class="copyright">
      © {year} {catalog.site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--forest);
    padding: 4.5rem 1.25rem 2.5rem;
  }

  .inner {
    width: min(36rem, 100%);
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* The header stays pinned to the top of the window. When the About link
     jumps here, stop below it with some breathing room so the heading shows. */
  #about,
  #contact {
    scroll-margin-top: calc(var(--header) + 2.5rem);
  }

  #contact {
    margin-top: 3.5rem;
  }

  img {
    display: block;
    width: min(100%, 16rem);
    max-height: 22rem;
    height: auto;
    margin: 0 0 1.25rem;
    object-fit: cover;
    object-position: center top;
  }

  .about-copy {
    margin: 0 0 1rem;
    white-space: pre-line;
  }

  /* Links in the bio: the same colour as the words, with a quiet underline
     that brightens on hover, so they read as links without shouting. */
  .about-copy a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(154, 147, 134, 0.55);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 200ms ease;
  }

  .about-copy a:hover {
    text-decoration-color: var(--bone);
  }

  form {
    display: grid;
    gap: 1.15rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--taupe);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  input,
  textarea {
    width: 100%;
    margin: 0;
    padding: 0.55rem 0;
    border: none;
    border-bottom: 1px solid var(--forest);
    border-radius: 0;
    background: transparent;
    color: var(--bone);
    font: inherit;
    letter-spacing: 0;
    text-transform: none;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  button {
    justify-self: start;
    margin-top: 0.4rem;
    padding: 0.75rem 1.4rem;
    border: 1px solid var(--taupe);
    background: transparent;
    color: var(--bone);
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--bone);
  }

  button:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  /* The spam trap: off screen, never seen. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }

  .form-note {
    margin: 0;
    min-height: 1.4rem;
    color: var(--taupe);
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .copyright {
    margin: 3rem 0 0;
    color: var(--taupe);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }
</style>
