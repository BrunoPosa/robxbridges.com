---
// Collaborations come from references/links.md, in the order written there.
// The newest goes first. A row is a name plus an https link. Optional notes
// sit under that name:
//
// - Ada Example: https://ada.bandcamp.com/track/song
//   - project: Song Title
//   - role: Written and produced together
//   - year: 2024
//   - cover: public/images/collabs/song-title.jpg
//   - player: 1234567890
//   - instagram: https://www.instagram.com/ada/
//
// cover is a square picture, about 800 pixels wide, in public/images/collabs/.
// player is the Bandcamp track number (Share / Embed, the number after track=).
// With a player, the row plays the track right here. Without one, pressing
// the cover opens the link instead.
// Leave ## Collaborations empty until there is a real person to list.
import Base from "../layouts/Base.astro";
import { bandcampPlayerSrc, loadCatalog, publicSrc, slugify } from "../data/catalog";
import { isPlayerGone } from "../data/bandcamp-check";

const { collaborations } = loadCatalog();

// Asked of Bandcamp while the site is built. A track Bandcamp has taken down
// shows a gray panel instead of Bandcamp's white "Sorry" box.
const goneFlags = await Promise.all(
  collaborations.map((collaboration) =>
    collaboration.playerId
      ? isPlayerGone("track", collaboration.playerId)
      : Promise.resolve(false),
  ),
);

// Bandcamp's player with no track list is about 120px tall.
const playerHeight = 120;

// "with DJ WUF". A name that already says "with" is shown as written.
function withLine(name: string): string {
  return /\bwith\b/i.test(name) ? name : `with ${name}`;
}

// The words on the main link: names Bandcamp only when it goes there.
function linkLabel(url: string, hasPlayer: boolean): string {
  if (!new URL(url).hostname.endsWith("bandcamp.com")) return "Listen";
  return hasPlayer ? "Bandcamp" : "Listen on Bandcamp";
}
---

<Base title="Collaborations">
  <article class="collabs">
    <h1 class="visually-hidden">Collaborations</h1>
    {collaborations.length === 0 ? (
      <p class="quiet">Selected work with others will be listed here.</p>
    ) : (
      <>
        <script is:inline>
          // Bandcamp's player is a blank white box until it draws itself, so a
          // gray stand-in covers it while it loads. Bandcamp says
          // "playerinited" when it is drawn. As a backup, the stand-in also
          // lifts shortly after the player has loaded.
          (() => {
            const ready = (frame) => {
              const box = frame.closest(".collab-player");
              if (box) box.dataset.state = "ready";
            };
            addEventListener("message", (event) => {
              if (
                event.origin !== "https://bandcamp.com" ||
                event.data !== "playerinited"
              )
                return;
              for (const frame of document.querySelectorAll(".collab-player iframe")) {
                if (frame.contentWindow === event.source) ready(frame);
              }
            });
            // A frame's load event does not bubble, so listen on the way down.
            document.addEventListener(
              "load",
              (event) => {
                const frame = event.target;
                if (
                  frame instanceof HTMLIFrameElement &&
                  frame.closest(".collab-player")
                ) {
                  setTimeout(() => ready(frame), 2000);
                }
              },
              true,
            );
          })();
        </script>
        {collaborations.map((collaboration, index) => {
          const title = collaboration.project ?? collaboration.name;
          const cover = collaboration.cover ? publicSrc(collaboration.cover) : "";
          const gone = goneFlags[index];
          // A removed track's Bandcamp page is gone too, so drop that link.
          const showLink = !(
            gone && new URL(collaboration.url).hostname.endsWith("bandcamp.com")
          );
          // The cover is a link only while there is somewhere to go.
          const CoverTag = showLink ? "a" : "div";
          return (
            <section
              class="collab"
              id={slugify(title)}
              aria-labelledby={`collab-${index}`}
            >
              {cover && (
                <CoverTag
                  class="collab-cover"
                  aria-hidden="true"
                  {...(showLink
                    ? {
                        href: collaboration.url,
                        target: "_blank",
                        rel: "noopener noreferrer",
                        tabindex: "-1",
                      }
                    : {})}
                >
                  <img
                    src={cover}
                    alt=""
                    width="800"
                    height="800"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </CoverTag>
              )}
              <div class="collab-text">
                <h2 id={`collab-${index}`}>
                  {title}
                  {collaboration.year && (
                    <span class="film-year">{collaboration.year}</span>
                  )}
                </h2>
                {collaboration.project && (
                  <p class="collab-with">{withLine(collaboration.name)}</p>
                )}
                {collaboration.role && <p class="collab-role">{collaboration.role}</p>}
                {collaboration.playerId && gone && (
                  <div class="player-frame collab-player" data-state="gone">
                    <p class="player-gone">Not available right now :(</p>
                  </div>
                )}
                {collaboration.playerId && !gone && (
                  <div class="player-frame collab-player" data-state="loading">
                    <!-- A gray outline of the player, shown until it loads. -->
                    <div class="player-skeleton collab-skeleton" aria-hidden="true">
                      <div class="skeleton-top">
                        <span class="skeleton-play" />
                        <span class="skeleton-lines">
                          <span />
                          <span />
                          <span class="skeleton-timeline" />
                        </span>
                      </div>
                    </div>
                    <!-- With JavaScript off, Bandcamp's player stays a white
                         box, so offer its own page instead. -->
                    <noscript>
                      <p class="player-error player-noscript">
                        The player needs JavaScript.
                        <a
                          href={collaboration.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Listen on Bandcamp
                        </a>
                      </p>
                    </noscript>
                    <iframe
                      class="player"
                      title={`${title} on Bandcamp`}
                      src={bandcampPlayerSrc("track", collaboration.playerId, false)}
                      height={playerHeight}
                      style={`height:${playerHeight}px`}
                      loading="lazy"
                      allow="autoplay; encrypted-media"
                    />
                  </div>
                )}
                <p class="collab-links">
                  {showLink && (
                    <a
                      href={collaboration.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {linkLabel(collaboration.url, Boolean(collaboration.playerId))}
                    </a>
                  )}
                  {collaboration.instagram && (
                    <a
                      href={collaboration.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Instagram
                    </a>
                  )}
                </p>
              </div>
            </section>
          );
        })}
      </>
    )}
  </article>
</Base>
