---
// Film order follows references/links.md. Keep Aryk first.
// A summary line shows under the title. A credits line stays behind Credits.
// Chinese Dictionary pieces show their still, then Instagram's embed in that square.
// The video file stays on Instagram.
import Base from "../layouts/Base.astro";
import { loadCatalog, publicSrc } from "../data/catalog";

const { films, dictionary } = loadCatalog();

type Slide = {
  title: string;
  url: string;
  poster: string;
  summary?: string;
  credits?: string;
  kicker?: string;
  youtubeId?: string;
  startSeconds?: number;
  instagram?: string;
  outbound: string;
};

function instagramEmbed(url: string): string {
  const code = new URL(url).pathname.split("/").filter(Boolean)[1] ?? "";
  return `https://www.instagram.com/p/${code}/embed/`;
}

const slides: Slide[] = [
  ...films.map((film) => ({
    title: film.title,
    url: film.url,
    poster: `https://i.ytimg.com/vi/${film.youtubeId}/hqdefault.jpg`,
    summary: film.summary,
    credits: film.credits,
    youtubeId: film.youtubeId,
    startSeconds: film.startSeconds ?? 0,
    outbound: "YouTube",
  })),
  ...dictionary.map((piece) => ({
    title: piece.title,
    url: piece.url,
    poster: piece.poster ? publicSrc(piece.poster) : "",
    summary: piece.summary,
    credits: piece.credits,
    kicker: "Chinese Dictionary",
    instagram: instagramEmbed(piece.url),
    outbound: "Instagram",
  })),
];

function indexLabel(index: number): string {
  return String(index + 1).padStart(2, "0");
}
---

<Base title="Films">
  <button type="button" class="film-top">
    Top
  </button>
  <nav class="film-rail" aria-label="Works">
    {slides.map((slide, index) => (
      <button
        type="button"
        class="film-rail-item"
        aria-current={index === 0 ? "true" : undefined}
      >
        <span class="film-rail-line"></span>
        <span class="film-rail-name">{slide.title}</span>
      </button>
    ))}
  </nav>
  <div class="reel">
    <h1 class="reel-title">Films</h1>
    {slides.map((slide, index) => (
      <article
        class="film-slide"
        data-title={slide.title}
        data-youtube-id={slide.youtubeId}
        data-start={slide.youtubeId ? slide.startSeconds : undefined}
        data-instagram={slide.instagram}
      >
        <div class="film-stage">
          {slide.instagram ? (
            <div class="film-embed">
              <img
                class="film-embed-still"
                src={slide.poster}
                alt=""
                width="640"
                height="640"
                loading="lazy"
              />
              <div class="film-embed-frame"></div>
              <button type="button" class="film-play">
                Play
              </button>
            </div>
          ) : (
            <>
              <img
                class="film-poster"
                src={slide.poster}
                alt=""
                width="480"
                height="360"
                loading={index === 0 ? "eager" : "lazy"}
              />
              <button type="button" class="film-play">
                Play
              </button>
              <div class="film-player"></div>
              {/* The middle catches a scroll. YouTube's captions and sound
                  stay outside this layer so those buttons can be clicked. */}
              <div class="film-scroll"></div>
            </>
          )}
        </div>
        <div class="film-caption">
          <p class="film-index">{indexLabel(index)}</p>
          <div class="film-copy">
            {slide.kicker && <p class="film-kicker">{slide.kicker}</p>}
            <h2>{slide.title}</h2>
            {slide.summary && <p>{slide.summary}</p>}
          </div>
          <div class="film-actions">
            {!slide.instagram && (
              <button type="button" class="film-sound" aria-pressed="false">
                Sound
              </button>
            )}
            {slide.credits && (
              <button
                type="button"
                class="film-credits"
                aria-expanded="false"
                aria-controls={`credits-${index}`}
              >
                Credits
              </button>
            )}
            <a href={slide.url} target="_blank" rel="noopener noreferrer">
              {slide.outbound}
            </a>
          </div>
        </div>
        {slide.credits && (
          <div class="film-credits-overlay" id={`credits-${index}`} hidden>
            <div
              class="film-credits-card"
              role="dialog"
              aria-labelledby={`credits-label-${index}`}
            >
              <h3 id={`credits-label-${index}`}>Credits</h3>
              <p>{slide.credits}</p>
              <button type="button" class="film-credits-close">
                Close
              </button>
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</Base>

<script>
  // The film in front plays. The one it covers stays paused on its last frame
  // until you move on. Scrolling down brings the next film up over this one.
  // Scrolling up lets this one slide down and uncovers the previous film.
  // One gesture moves one piece, then About. Aryk starts on its own, muted,
  // because a browser will not start sound by itself. Sound keeps that choice
  // for the next YouTube film. YouTube's own captions and sound stay clickable.
  // A Chinese Dictionary piece shows its still, and loads one Instagram embed
  // only while it is the piece on screen. prefers-reduced-motion waits for Play.
  // The marks on the left fade out once a piece is playing, and again over About.
  // Moving the pointer, or touching the screen, brings them back.

  interface YouTubePlayer {
    destroy: () => void;
    mute: () => void;
    unMute: () => void;
    playVideo: () => void;
    pauseVideo: () => void;
    isMuted: () => boolean;
    getIframe: () => HTMLIFrameElement;
  }

  interface YouTubePlayerOptions {
    videoId: string;
    width?: string;
    height?: string;
    host?: string;
    playerVars?: Record<string, number | string>;
    events?: {
      onReady?: (event: { target: YouTubePlayer }) => void;
    };
  }

  interface YouTubeNamespace {
    Player: new (element: HTMLElement, options: YouTubePlayerOptions) => YouTubePlayer;
  }

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function headerHeight(): number {
    const header = document.querySelector(".site-header");
    return header instanceof HTMLElement ? header.offsetHeight : 0;
  }

  function syncHeader(): void {
    document.documentElement.style.setProperty("--header-live", `${headerHeight()}px`);
  }

  syncHeader();
  window.addEventListener("resize", syncHeader);
  const ratios = new Map<Element, number>();

  let soundOn = false;
  let active: HTMLElement | null = null;
  let parked: HTMLElement | null = null;
  const players = new Map<HTMLElement, YouTubePlayer>();
  const modes = new Map<HTMLElement, "api" | "plain" | "instagram">();
  const tokens = new WeakMap<HTMLElement, number>();
  let pending = 0;
  let apiReady: Promise<void> | null = null;
  let topTimer = 0;
  // Which stop is current. The last stop is About, after the films.
  let dock = 0;
  let travel = false;
  let trip = 0;
  // 1 means the next film is arriving. -1 means the previous one is returning.
  let scrollDir = 1;
  let pastFilms = false;
  let railAwake = true;
  let railTimer = 0;
  let dragging = false;

  function slideList(): HTMLElement[] {
    return [...document.querySelectorAll(".film-slide")].filter(
      (slide): slide is HTMLElement => slide instanceof HTMLElement,
    );
  }

  function bump(slide: HTMLElement): number {
    const mine = (tokens.get(slide) ?? 0) + 1;
    tokens.set(slide, mine);
    return mine;
  }

  function pageWindow(): Window & {
    YT?: YouTubeNamespace;
    onYouTubeIframeAPIReady?: () => void;
  } {
    return window as Window & {
      YT?: YouTubeNamespace;
      onYouTubeIframeAPIReady?: () => void;
    };
  }

  function readYouTube(): YouTubeNamespace | undefined {
    const yt = pageWindow().YT;
    if (!yt || typeof yt.Player !== "function") return undefined;
    return yt;
  }

  function syncSound(): void {
    for (const button of document.querySelectorAll(".film-sound")) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.setAttribute("aria-pressed", soundOn ? "true" : "false");
      button.textContent = soundOn ? "Mute" : "Sound";
    }
  }

  function showPlay(slide: HTMLElement): void {
    const play = slide.querySelector(".film-play");
    if (play instanceof HTMLButtonElement) play.hidden = false;
  }

  function showPlaying(slide: HTMLElement): void {
    const started = !slide.classList.contains("is-playing");
    slide.classList.add("is-playing");
    if (started && slide === active) restRail();
  }

  function hidePlaying(slide: HTMLElement): void {
    slide.classList.remove("is-playing");
    if (slide === active) syncRail();
  }

  function closeCredits(scope: ParentNode = document): void {
    for (const overlay of scope.querySelectorAll(".film-credits-overlay")) {
      if (overlay instanceof HTMLElement) overlay.hidden = true;
    }
    for (const button of scope.querySelectorAll(".film-credits")) {
      if (button instanceof HTMLButtonElement)
        button.setAttribute("aria-expanded", "false");
    }
  }

  function shutCredits(overlay: HTMLElement, returnFocus: boolean): void {
    const slide = overlay.closest(".film-slide");
    overlay.hidden = true;
    const button = slide?.querySelector(".film-credits");
    if (!(button instanceof HTMLButtonElement)) return;
    button.setAttribute("aria-expanded", "false");
    if (returnFocus) button.focus();
  }

  function openCredits(slide: HTMLElement): void {
    const overlay = slide.querySelector(".film-credits-overlay");
    const button = slide.querySelector(".film-credits");
    if (!(overlay instanceof HTMLElement) || !(button instanceof HTMLButtonElement))
      return;
    closeCredits();
    overlay.hidden = false;
    button.setAttribute("aria-expanded", "true");
    const close = overlay.querySelector(".film-credits-close");
    if (close instanceof HTMLButtonElement) close.focus();
  }

  function ensureApi(): Promise<void> {
    if (readYouTube()) return Promise.resolve();
    if (apiReady) return apiReady;
    apiReady = new Promise((resolve, reject) => {
      const timer = window.setTimeout(() => reject(new Error("timeout")), 8000);
      pageWindow().onYouTubeIframeAPIReady = () => {
        window.clearTimeout(timer);
        resolve();
      };
      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      tag.onerror = () => {
        window.clearTimeout(timer);
        reject(new Error("blocked"));
      };
      document.head.append(tag);
    });
    return apiReady;
  }

  function destroyPlayer(slide: HTMLElement): void {
    const existing = players.get(slide);
    try {
      existing?.destroy();
    } catch {
      // A player that never finished loading can already be gone.
    }
    players.delete(slide);
    modes.delete(slide);
    const embed = slide.querySelector(".film-embed-frame");
    if (embed) embed.replaceChildren();
    else slide.querySelector(".film-player")?.replaceChildren();
    hidePlaying(slide);
    showPlay(slide);
    closeCredits(slide);
  }

  // YouTube's own speaker is the control on the picture. Remember it for the next film.
  function rememberSound(slide: HTMLElement): void {
    const existing = players.get(slide);
    if (modes.get(slide) !== "api" || !existing) return;
    try {
      soundOn = !existing.isMuted();
      syncSound();
    } catch {
      // Keep the last choice if the player cannot answer.
    }
  }

  // Pause, and leave the picture up, so the next film can slide over it.
  function hold(slide: HTMLElement): void {
    const existing = players.get(slide);
    if (modes.get(slide) === "api" && existing) {
      try {
        existing.pauseVideo();
      } catch {
        // The frame can stay even if pause does not land.
      }
    }
    closeCredits(slide);
  }

  function stop(slide: HTMLElement): void {
    bump(slide);
    destroyPlayer(slide);
    if (parked === slide) parked = null;
  }

  function playerStarting(slide: HTMLElement): boolean {
    return Boolean(
      slide.querySelector(
        ".film-player iframe, .film-player div, .film-embed-frame iframe",
      ),
    );
  }

  function fit(frame: HTMLIFrameElement, title: string): void {
    frame.classList.add("film-frame");
    frame.title = title;
    frame.style.width = "100%";
    frame.style.height = "100%";
    frame.allow = "autoplay; fullscreen; picture-in-picture";
    frame.setAttribute("allowfullscreen", "");
    frame.referrerPolicy = "strict-origin-when-cross-origin";
  }

  function mountPlain(slide: HTMLElement, mine: number): void {
    const holder = slide.querySelector(".film-player");
    const videoId = slide.dataset.youtubeId ?? "";
    if (!(holder instanceof HTMLElement) || !videoId || mine !== tokens.get(slide))
      return;
    const start = slide.dataset.start || "0";
    const frame = document.createElement("iframe");
    const mute = soundOn ? "0" : "1";
    frame.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&mute=${mute}&start=${encodeURIComponent(start)}&playsinline=1&rel=0&controls=1`;
    fit(frame, slide.dataset.title || "Film");
    holder.replaceChildren(frame);
    modes.set(slide, "plain");
    showPlaying(slide);
  }

  function mount(slide: HTMLElement): void {
    const mine = bump(slide);
    const holder = slide.querySelector(".film-player");
    const videoId = slide.dataset.youtubeId ?? "";
    if (!(holder instanceof HTMLElement) || !videoId) return;
    const existing = players.get(slide);
    try {
      existing?.destroy();
    } catch {
      // Replacing a player that never finished loading.
    }
    players.delete(slide);
    modes.delete(slide);
    holder.replaceChildren();
    const start = Number(slide.dataset.start || "0");
    const title = slide.dataset.title || "Film";
    const slot = document.createElement("div");
    holder.append(slot);

    ensureApi()
      .then(() => {
        const yt = readYouTube();
        if (!yt || mine !== tokens.get(slide) || active !== slide) return;
        new yt.Player(slot, {
          videoId,
          width: "100%",
          height: "100%",
          host: "https://www.youtube-nocookie.com",
          playerVars: {
            autoplay: 1,
            mute: soundOn ? 0 : 1,
            start: Number.isFinite(start) ? start : 0,
            playsinline: 1,
            rel: 0,
            controls: 1,
            modestbranding: 1,
            origin: window.location.origin,
          },
          events: {
            onReady(event) {
              if (mine !== tokens.get(slide) || active !== slide) {
                event.target.destroy();
                return;
              }
              players.set(slide, event.target);
              modes.set(slide, "api");
              fit(event.target.getIframe(), title);
              if (soundOn) event.target.unMute();
              else event.target.mute();
              event.target.playVideo();
              showPlaying(slide);
            },
          },
        });
      })
      .catch(() => {
        if (mine !== tokens.get(slide) || active !== slide) return;
        mountPlain(slide, mine);
      });
  }

  function mountEmbed(slide: HTMLElement): void {
    const mine = bump(slide);
    const holder = slide.querySelector(".film-embed-frame");
    const src = slide.dataset.instagram ?? "";
    if (!(holder instanceof HTMLElement) || !src) return;
    const frame = document.createElement("iframe");
    frame.src = src;
    frame.title = slide.dataset.title || "Film";
    frame.className = "film-frame";
    frame.setAttribute("scrolling", "no");
    frame.allow =
      "autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share";
    frame.setAttribute("allowfullscreen", "");
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    frame.addEventListener("load", () => {
      if (mine !== tokens.get(slide) || active !== slide) return;
      modes.set(slide, "instagram");
      showPlaying(slide);
    });
    holder.replaceChildren(frame);
  }

  function resume(slide: HTMLElement): void {
    const existing = players.get(slide);
    if (modes.get(slide) === "api" && existing) {
      if (soundOn) existing.unMute();
      else existing.mute();
      existing.playVideo();
      showPlaying(slide);
      const play = slide.querySelector(".film-play");
      if (play instanceof HTMLButtonElement) play.hidden = true;
      return;
    }
    if (slide.dataset.instagram) mountEmbed(slide);
    else mount(slide);
  }

  function releaseOthers(keep: HTMLElement, also: HTMLElement | null): void {
    for (const slide of slideList()) {
      if (slide === keep || slide === also) continue;
      if (
        players.has(slide) ||
        modes.has(slide) ||
        slide.classList.contains("is-playing")
      ) {
        stop(slide);
      }
    }
  }

  function activate(slide: HTMLElement, autoplay: boolean): void {
    if (
      active === slide &&
      (slide.classList.contains("is-playing") ||
        playerStarting(slide) ||
        players.has(slide))
    ) {
      return;
    }
    const previous = active;
    const previousIndex = previous ? slideList().indexOf(previous) : -1;
    const nextIndex = slideList().indexOf(slide);
    const adjacent =
      previous !== null &&
      previousIndex >= 0 &&
      Math.abs(previousIndex - nextIndex) === 1;

    if (previous && previous !== slide) {
      rememberSound(previous);
      if (adjacent && !reduced) hold(previous);
      else stop(previous);
    }

    active = slide;
    parked = previous && previous !== slide && adjacent && !reduced ? previous : null;
    releaseOthers(slide, parked);
    for (const layer of document.querySelectorAll(".film-scroll")) {
      if (layer instanceof HTMLElement) layer.style.pointerEvents = "";
    }
    markRail(slide);
    const playable = Boolean(slide.dataset.youtubeId || slide.dataset.instagram);
    if (!autoplay || !playable) return;
    const play = slide.querySelector(".film-play");
    if (play instanceof HTMLButtonElement) play.hidden = true;
    if (players.has(slide)) {
      resume(slide);
      return;
    }
    if (slide.dataset.instagram) mountEmbed(slide);
    else mount(slide);
  }

  function choose(): void {
    const slides = slideList();
    let best: HTMLElement | null = null;
    if (reduced) {
      let bestRatio = 0.55;
      for (const slide of slides) {
        const ratio = ratios.get(slide) ?? 0;
        if (ratio >= bestRatio) {
          best = slide;
          bestRatio = ratio;
        }
      }
    } else {
      // A stuck film sits under the header. The next one counts once it
      // covers enough of the screen on the way up. On the way back, the film
      // that has started to leave is no longer the one in front.
      const line = headerHeight() + 16;
      let stuck: HTMLElement | null = null;
      let approaching: HTMLElement | null = null;
      for (const slide of slides) {
        const rect = slide.getBoundingClientRect();
        if (rect.top <= line) {
          stuck = slide;
          continue;
        }
        if (approaching || rect.height <= 0) continue;
        const visible =
          Math.min(window.innerHeight, rect.bottom) - Math.max(0, rect.top);
        if (visible / rect.height >= 0.42) approaching = slide;
      }
      best = scrollDir < 0 ? stuck : (approaching ?? stuck);
    }
    if (!best || best === active) return;
    activate(best, !reduced);
  }

  function setSound(on: boolean): void {
    soundOn = on;
    syncSound();
    if (!active?.dataset.youtubeId) return;
    const existing = players.get(active);
    if (modes.get(active) === "api" && existing) {
      if (on) {
        existing.unMute();
        existing.playVideo();
      } else {
        existing.mute();
      }
      return;
    }
    const play = active.querySelector(".film-play");
    if (play instanceof HTMLButtonElement) play.hidden = true;
    mount(active);
  }

  function markRail(slide: HTMLElement | null): void {
    const slides = [...document.querySelectorAll(".film-slide")];
    const index = slide ? slides.indexOf(slide) : -1;
    document.querySelectorAll(".film-rail-item").forEach((item, itemIndex) => {
      if (!(item instanceof HTMLButtonElement)) return;
      if (itemIndex === index) item.setAttribute("aria-current", "true");
      else item.removeAttribute("aria-current");
    });
  }

  function maxScroll(): number {
    return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
  }

  function slidePitch(): number {
    return slideList()[0]?.offsetHeight || window.innerHeight;
  }

  // A stuck film's offsetTop moves to where it is stuck, so it cannot be used
  // to find the way back. Every piece is one screen tall, and About follows them.
  function stopTop(index: number): number {
    const count = slideList().length;
    const stop = Math.max(0, Math.min(count, index));
    return stop * slidePitch();
  }

  // About is tall enough to read past its first screen. Leave that scroll alone.
  function footerRoom(direction: number): boolean {
    const footerTop = stopTop(slideList().length);
    const y = window.scrollY;
    if (y < footerTop - 2) return false;
    if (direction > 0) return y < maxScroll() - 2;
    return y > footerTop + 2;
  }

  function scrollFilmsTo(top: number): void {
    const root = document.documentElement;
    const mine = ++trip;
    travel = true;
    closeCredits();
    root.style.scrollSnapType = "none";
    let restored = false;
    let watch = () => {};
    const restore = () => {
      if (restored || mine !== trip) return;
      restored = true;
      window.clearTimeout(topTimer);
      window.removeEventListener("scroll", watch);
      root.style.scrollSnapType = "";
      travel = false;
      updatePastFilms();
    };
    const destination = Math.max(0, Math.min(maxScroll(), top));
    watch = () => {
      if (mine !== trip) {
        window.removeEventListener("scroll", watch);
        return;
      }
      if (Math.abs(window.scrollY - destination) <= 3) restore();
    };
    window.addEventListener("scroll", watch, { passive: true });
    window.scrollTo({ top: destination, behavior: reduced ? "auto" : "smooth" });
    watch();
    if (restored) return;
    window.addEventListener("scrollend", restore, { once: true });
    window.clearTimeout(topTimer);
    topTimer = window.setTimeout(restore, 1200);
  }

  function goDock(index: number): void {
    const last = slideList().length;
    const next = Math.max(0, Math.min(last, index));
    if (next !== dock) scrollDir = next < dock ? -1 : 1;
    dock = next;
    scrollFilmsTo(stopTop(next));
  }

  function goTop(): void {
    goDock(0);
  }

  function syncDock(): void {
    const y = window.scrollY;
    const last = slideList().length;
    if (y > stopTop(last) + 24) {
      dock = last;
      return;
    }
    let best = 0;
    let bestDist = Infinity;
    for (let index = 0; index <= last; index += 1) {
      const dist = Math.abs(stopTop(index) - y);
      if (dist < bestDist) {
        bestDist = dist;
        best = index;
      }
    }
    dock = best;
  }

  function updatePastFilms(): void {
    const footer = document.querySelector(".site-footer");
    if (!(footer instanceof HTMLElement)) return;
    const next = footer.getBoundingClientRect().top < window.innerHeight * 0.62;
    if (next === pastFilms) return;
    const returned = pastFilms && !next;
    pastFilms = next;
    const marks = document.querySelector(".film-rail");
    if (pastFilms && marks instanceof HTMLElement) marks.classList.remove("is-open");
    if (returned) wakeRail();
    else syncRail();
  }

  function syncRail(): void {
    const marks = document.querySelector(".film-rail");
    if (!(marks instanceof HTMLElement)) return;
    const engaged =
      marks.matches(":hover") ||
      marks.matches(":focus-within") ||
      marks.classList.contains("is-open");
    const playing = Boolean(active?.classList.contains("is-playing"));
    const hide = pastFilms || (playing && !engaged && !railAwake);
    marks.classList.toggle("is-quiet", hide);
    // About is not a film. Keep the marks out of the tab order there.
    if (pastFilms) marks.setAttribute("inert", "");
    else marks.removeAttribute("inert");
  }

  function wakeRail(): void {
    railAwake = true;
    syncRail();
    window.clearTimeout(railTimer);
    railTimer = window.setTimeout(() => {
      railAwake = false;
      syncRail();
    }, 2400);
  }

  // A short rest after play starts, so the current mark can be seen, then it leaves.
  function restRail(): void {
    railAwake = true;
    syncRail();
    window.clearTimeout(railTimer);
    railTimer = window.setTimeout(() => {
      railAwake = false;
      syncRail();
    }, 1200);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) ratios.set(entry.target, entry.intersectionRatio);
      window.clearTimeout(pending);
      pending = window.setTimeout(choose, 160);
    },
    { threshold: [0.2, 0.42, 0.6, 0.85] },
  );

  for (const slide of document.querySelectorAll(".film-slide")) {
    observer.observe(slide);
  }

  for (const button of document.querySelectorAll(".film-play")) {
    button.addEventListener("click", () => {
      const slide = button.closest(".film-slide");
      if (!(slide instanceof HTMLElement)) return;
      activate(slide, true);
    });
  }

  for (const button of document.querySelectorAll(".film-sound")) {
    button.addEventListener("click", () => {
      setSound(!soundOn);
    });
  }

  for (const button of document.querySelectorAll(".film-credits")) {
    button.addEventListener("click", () => {
      const slide = button.closest(".film-slide");
      if (!(slide instanceof HTMLElement) || !(button instanceof HTMLButtonElement))
        return;
      const overlay = slide.querySelector(".film-credits-overlay");
      if (!(overlay instanceof HTMLElement)) return;
      if (overlay.hidden) openCredits(slide);
      else shutCredits(overlay, true);
    });
  }

  for (const overlay of document.querySelectorAll(".film-credits-overlay")) {
    overlay.addEventListener("click", (event) => {
      if (!(overlay instanceof HTMLElement) || event.target !== overlay) return;
      shutCredits(overlay, true);
    });
    const close = overlay.querySelector(".film-credits-close");
    close?.addEventListener("click", () => {
      if (overlay instanceof HTMLElement) shutCredits(overlay, true);
    });
  }

  function creditsOpen(): boolean {
    return Boolean(document.querySelector(".film-credits-overlay:not([hidden])"));
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      const open = document.querySelector(".film-credits-overlay:not([hidden])");
      if (open instanceof HTMLElement) shutCredits(open, true);
      return;
    }
    if (event.altKey || event.metaKey || event.ctrlKey || creditsOpen()) return;
    if (
      event.target instanceof Element &&
      event.target.closest("input, textarea, select")
    ) {
      return;
    }
    const direction =
      event.key === "ArrowDown" || event.key === "PageDown"
        ? 1
        : event.key === "ArrowUp" || event.key === "PageUp"
          ? -1
          : 0;
    if (!direction || footerRoom(direction)) return;
    event.preventDefault();
    if (!pastFilms) wakeRail();
    if (travel && direction === scrollDir) return;
    goDock(dock + direction);
  });

  const top = document.querySelector(".film-top");
  top?.addEventListener("click", goTop);

  const rail = document.querySelector(".film-rail");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  document.querySelectorAll(".film-rail-item").forEach((button, index) => {
    button.addEventListener("click", () => {
      const slide = document.querySelectorAll(".film-slide")[index];
      if (!(slide instanceof HTMLElement) || !(button instanceof HTMLButtonElement))
        return;
      // A phone has no hover. The first tap opens the titles; the next one goes there.
      if (
        !finePointer.matches &&
        rail instanceof HTMLElement &&
        !rail.classList.contains("is-open")
      ) {
        rail.classList.add("is-open");
        return;
      }
      if (rail instanceof HTMLElement) rail.classList.remove("is-open");
      goDock(index);
      button.blur();
    });
  });

  let railPress: { x: number; y: number } | null = null;

  document.addEventListener("pointerdown", (event) => {
    if (!(rail instanceof HTMLElement)) return;
    const quiet = rail.classList.contains("is-quiet");
    if (!pastFilms) wakeRail();
    if (rail.classList.contains("is-open")) {
      if (event.target instanceof Node && rail.contains(event.target)) return;
      rail.classList.remove("is-open");
      return;
    }
    if (finePointer.matches || !quiet || pastFilms) return;
    const rect = rail.getBoundingClientRect();
    const pad = 28;
    const onRail =
      event.clientX >= rect.left - pad &&
      event.clientX <= rect.right + pad &&
      event.clientY >= rect.top - pad &&
      event.clientY <= rect.bottom + pad;
    if (!onRail) return;
    railPress = { x: event.clientX, y: event.clientY };
  });

  document.addEventListener("pointerup", (event) => {
    if (!railPress || !(rail instanceof HTMLElement)) {
      railPress = null;
      return;
    }
    const dx = event.clientX - railPress.x;
    const dy = event.clientY - railPress.y;
    railPress = null;
    if (dx * dx + dy * dy > 64) return;
    rail.classList.add("is-open");
    wakeRail();
    // The marks were not receiving this tap. Don't let it hit Play underneath.
    document.addEventListener(
      "click",
      (click) => {
        click.preventDefault();
        click.stopPropagation();
      },
      { capture: true, once: true },
    );
  });

  document.addEventListener("pointercancel", () => {
    railPress = null;
  });

  // A resting pointer over the middle of the picture scrolls one film.
  // The page wheel and the drag below move to the next or the previous.
  // Moving that pointer steps the layer aside so YouTube can take the click.
  // Captions and sound sit outside the layer, so they stay clickable either way.
  // Once the pointer is on YouTube's own bar, the layer stays aside until it leaves.
  if (finePointer.matches) {
    let restore = 0;
    let onChrome = false;

    const catcher = (): HTMLElement | null => {
      const layer = active?.querySelector(".film-scroll");
      return layer instanceof HTMLElement ? layer : null;
    };

    const aside = (layer: HTMLElement) => {
      layer.style.pointerEvents = "none";
    };

    const arm = (layer: HTMLElement) => {
      if (onChrome) return;
      layer.style.pointerEvents = "";
    };

    for (const layer of document.querySelectorAll(".film-scroll")) {
      if (!(layer instanceof HTMLElement)) continue;
      const stepAside = () => {
        if (onChrome) return;
        aside(layer);
        window.clearTimeout(restore);
        restore = window.setTimeout(() => arm(layer), 1400);
      };
      layer.addEventListener("pointermove", stepAside);
      layer.addEventListener("pointerrawupdate", stepAside);
    }

    const overStage = (x: number, y: number): boolean => {
      const stage = active?.querySelector(".film-stage");
      if (!(stage instanceof HTMLElement)) return false;
      const rect = stage.getBoundingClientRect();
      return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
    };

    document.addEventListener("mouseout", (event) => {
      if (event.relatedTarget !== null) return;
      const layer = catcher();
      if (!layer || !overStage(event.clientX, event.clientY)) return;
      onChrome = true;
      window.clearTimeout(restore);
      aside(layer);
    });

    document.addEventListener("mousemove", (event) => {
      const layer = catcher();
      if (!layer || overStage(event.clientX, event.clientY)) return;
      onChrome = false;
      window.clearTimeout(restore);
      layer.style.pointerEvents = "";
    });
  }

  // Ignore a mousemove that did not move. Scrolling can fire one when the
  // picture under a still cursor changes, and that would bring the marks back
  // the moment they fade.
  let pointerAt = { x: -1, y: -1 };
  document.addEventListener("mousemove", (event) => {
    const dx = event.clientX - pointerAt.x;
    const dy = event.clientY - pointerAt.y;
    pointerAt = { x: event.clientX, y: event.clientY };
    if (pastFilms) return;
    if (dx * dx + dy * dy < 16) return;
    wakeRail();
  });

  if (rail instanceof HTMLElement) {
    rail.addEventListener("pointerleave", () => {
      if (!pastFilms) wakeRail();
    });
    rail.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!pastFilms) wakeRail();
      }, 0);
    });
  }

  function wheelDelta(event: WheelEvent): number {
    if (event.deltaMode === 1) return event.deltaY * 16;
    if (event.deltaMode === 2) return event.deltaY * window.innerHeight;
    return event.deltaY;
  }

  let carry = 0;
  let carryTimer = 0;
  let sameWayUntil = 0;

  document.addEventListener(
    "wheel",
    (event) => {
      if (event.ctrlKey || creditsOpen()) return;
      const delta = wheelDelta(event);
      if (delta === 0 || Math.abs(event.deltaX) > Math.abs(delta)) return;
      const direction = delta > 0 ? 1 : -1;
      if (footerRoom(direction)) return;
      event.preventDefault();
      if (!pastFilms) wakeRail();
      // One gesture moves one piece. A wheel the other way can turn around
      // before the first piece has finished sliding.
      if (
        dragging ||
        (direction === scrollDir && (travel || performance.now() < sameWayUntil))
      ) {
        return;
      }
      window.clearTimeout(carryTimer);
      carryTimer = window.setTimeout(() => {
        carry = 0;
      }, 160);
      carry += delta;
      if (Math.abs(carry) < 36) return;
      carry = 0;
      sameWayUntil = performance.now() + 900;
      goDock(dock + direction);
    },
    { passive: false },
  );

  // A finger follows the cover for one piece, then the scroll finishes that piece.
  let drag: {
    x: number;
    y: number;
    scroll: number;
    dock: number;
    id: number;
    hijack: boolean;
  } | null = null;
  let swallowClick = false;

  function dragBlocked(target: EventTarget | null): boolean {
    if (!(target instanceof Element)) return true;
    return Boolean(
      target.closest(
        "input, textarea, select, a, button, .film-rail, .film-top, .site-footer",
      ),
    );
  }

  document.addEventListener(
    "touchstart",
    (event) => {
      if (event.touches.length !== 1 || creditsOpen() || dragBlocked(event.target))
        return;
      const touch = event.touches[0];
      if (!touch) return;
      drag = {
        x: touch.clientX,
        y: touch.clientY,
        scroll: window.scrollY,
        dock,
        id: touch.identifier,
        hijack: false,
      };
    },
    { passive: true },
  );

  document.addEventListener(
    "touchmove",
    (event) => {
      if (!drag) return;
      const touch = [...event.touches].find((item) => item.identifier === drag?.id);
      if (!touch || !drag) return;
      const dx = touch.clientX - drag.x;
      const dy = touch.clientY - drag.y;
      if (!drag.hijack) {
        if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) {
          drag = null;
          return;
        }
        if (Math.abs(dy) < 8) return;
        const direction = dy < 0 ? 1 : -1;
        if (footerRoom(direction)) {
          drag = null;
          return;
        }
        drag.hijack = true;
        dragging = true;
        if (!pastFilms) wakeRail();
      }
      if (!event.cancelable) return;
      event.preventDefault();
      const min = stopTop(Math.max(0, drag.dock - 1));
      const max = stopTop(Math.min(slideList().length, drag.dock + 1));
      const y = Math.min(max, Math.max(min, drag.scroll + (drag.y - touch.clientY)));
      if (y > drag.scroll + 8) scrollDir = 1;
      else if (y < drag.scroll - 8) scrollDir = -1;
      window.scrollTo(0, y);
    },
    { passive: false },
  );

  function endDrag(event: TouchEvent): void {
    if (!drag) return;
    const touch = [...event.changedTouches].find(
      (item) => item.identifier === drag?.id,
    );
    const started = drag;
    drag = null;
    if (started.hijack) travel = true;
    dragging = false;
    if (!touch || !started.hijack) return;
    const moved = window.scrollY - started.scroll;
    swallowClick = Math.abs(moved) > 10;
    const pitch = slidePitch();
    let target = started.dock;
    if (moved > pitch * 0.18) target = started.dock + 1;
    else if (moved < pitch * -0.18) target = started.dock - 1;
    goDock(target);
  }

  document.addEventListener("touchend", endDrag);
  document.addEventListener("touchcancel", endDrag);
  document.addEventListener(
    "click",
    (event) => {
      if (!swallowClick) return;
      swallowClick = false;
      event.preventDefault();
      event.stopPropagation();
    },
    true,
  );

  window.addEventListener(
    "scroll",
    () => {
      updatePastFilms();
    },
    { passive: true },
  );

  window.addEventListener("scrollend", () => {
    if (travel || dragging) return;
    const focused = document.activeElement;
    if (focused instanceof Element && focused.closest(".site-footer")) {
      dock = slideList().length;
      updatePastFilms();
      return;
    }
    const y = window.scrollY;
    const last = slideList().length;
    const footerTop = stopTop(last);
    if (y > footerTop + 24) {
      dock = last;
      updatePastFilms();
      return;
    }
    let best = 0;
    let bestDist = Infinity;
    for (let index = 0; index <= last; index += 1) {
      const dist = Math.abs(stopTop(index) - y);
      if (dist < bestDist) {
        bestDist = dist;
        best = index;
      }
    }
    if (bestDist > 2) goDock(best);
    else dock = best;
  });

  syncDock();
  updatePastFilms();
</script>
