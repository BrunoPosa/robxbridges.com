---
// Films come from references/links.md, in that order. Keep Aryk first.
// Each film shows its still with a Play button. Nothing plays until the
// visitor presses Play. The year, summary, and credits sit under the picture.
// A film can be on YouTube or Vimeo. Its link decides which player opens.
// Chinese Dictionary pieces are small squares. Pressing one plays its clip
// (hosted on this site) in a viewer over the page. Nothing downloads before.
import sharp from "sharp";
import Base from "../layouts/Base.astro";
import VideoDialog from "../components/VideoDialog.astro";
import { loadCatalog, publicSrc, slugify, type Film } from "../data/catalog";

const { films, dictionary, dictionaryInfo } = loadCatalog();

// The player's address. It only loads once Play is pressed.
function embedSrc(film: Film): string {
  const start = film.startSeconds ?? 0;
  if (film.host === "vimeo") {
    const hash = film.vimeoHash ? `h=${film.vimeoHash}&` : "";
    // dnt=1: Vimeo sets no tracking cookies.
    return `https://player.vimeo.com/video/${film.videoId}?${hash}autoplay=1&dnt=1#t=${start}s`;
  }
  return `https://www.youtube-nocookie.com/embed/${film.videoId}?autoplay=1&start=${start}&rel=0&playsinline=1&enablejsapi=1`;
}

// The still before Play. A poster line in links.md wins. Otherwise YouTube's.
function stills(film: Film): { src: string; fallback?: string } {
  if (film.poster) return { src: publicSrc(film.poster) };
  return {
    src: `https://i.ytimg.com/vi/${film.videoId}/maxresdefault.jpg`,
    fallback: `https://i.ytimg.com/vi/${film.videoId}/hqdefault.jpg`,
  };
}

// Each still's width / height. The still has the clip's shape, so the viewer
// can size itself before the clip loads.
const pieces = await Promise.all(
  dictionary.map(async (piece) => {
    const { width = 1, height = 1 } = await sharp(piece.poster).metadata();
    // The WebP copies made by scripts/make-thumbs.ts.
    const webp = publicSrc(piece.poster).replace(
      /^\/films\/(.+)\.jpg$/,
      "/films/posters/$1",
    );
    return { ...piece, ratio: (width / height).toFixed(4), webp };
  }),
);
---

<Base title="Films">
  <article class="films">
    <h1 class="visually-hidden">Films</h1>

    {films.map((film, index) => (
      <section class="film" id={slugify(film.title)} aria-labelledby={`film-${index}`}>
        <div
          class="film-frame"
          data-embed={embedSrc(film)}
          data-host={film.host}
        >
          <img
            class="film-poster"
            src={stills(film).src}
            data-fallback={stills(film).fallback}
            alt=""
            width="1280"
            height="720"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
          <button type="button" class="film-play" aria-label={`Play ${film.title}`}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
            </svg>
          </button>
        </div>
        <div class="film-text">
          <h2 id={`film-${index}`}>
            {film.title}
            {film.year && <span class="film-year">{film.year}</span>}
          </h2>
          {film.summary && <p>{film.summary}</p>}
          {film.credits && <p class="film-credits">{film.credits}</p>}
          <a
            class="film-link"
            href={film.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            {film.host === "vimeo" ? "Vimeo" : "YouTube"}
          </a>
        </div>
      </section>
    ))}

    <section
      class="dictionary"
      id="chinese-dictionary"
      aria-labelledby="dictionary-heading"
    >
      <div class="film-text">
        <h2 id="dictionary-heading">
          Chinese Dictionary
          {dictionaryInfo.year && <span class="film-year">{dictionaryInfo.year}</span>}
        </h2>
        {dictionaryInfo.summary && <p>{dictionaryInfo.summary}</p>}
        {dictionaryInfo.instagram && (
          <a
            class="film-link"
            href={dictionaryInfo.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>
        )}
      </div>
      <ul class="dictionary-grid">
        {pieces.map((piece) => (
          <li>
            <button
              type="button"
              class="dictionary-tile"
              data-dialog-video={publicSrc(piece.video)}
              data-dialog-poster={`${piece.webp}-640.webp`}
              data-dialog-ratio={piece.ratio}
              data-dialog-title={`${piece.title}, Chinese Dictionary`}
              data-dialog-link={piece.url}
            >
              <picture>
                <source
                  type="image/webp"
                  srcset={`${piece.webp}-320.webp 320w, ${piece.webp}-640.webp 640w`}
                  sizes="(max-width: 720px) 45vw, 17rem"
                />
                <img
                  src={publicSrc(piece.poster)}
                  alt=""
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span class="dictionary-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="12" height="12">
                  <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
                </svg>
              </span>
              <span class="dictionary-title">{piece.title}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  </article>
  <VideoDialog />
</Base>

<script>
  // Play swaps the still for the YouTube or Vimeo player. Starting another
  // film pauses the one before it, so only one plays at a time.
  const playing: HTMLIFrameElement[] = [];

  function pause(frame: HTMLIFrameElement): void {
    if (frame.dataset.host === "vimeo") {
      // Vimeo's player listens for this message.
      frame.contentWindow?.postMessage({ method: "pause" }, "https://player.vimeo.com");
      return;
    }
    // YouTube listens for this message when enablejsapi=1 is in the address.
    frame.contentWindow?.postMessage(
      JSON.stringify({ event: "command", func: "pauseVideo", args: [] }),
      "https://www.youtube-nocookie.com",
    );
  }

  // A Chinese Dictionary clip starting in the viewer pauses the films.
  document.addEventListener("video-dialog:play", () => {
    for (const frame of playing) pause(frame);
  });

  for (const holder of document.querySelectorAll<HTMLElement>(".film-frame")) {
    const poster = holder.querySelector<HTMLImageElement>(".film-poster");
    // A video without a large still gets YouTube's small gray stand-in (120px).
    // Use the medium still instead.
    const useFallback = () => {
      if (poster && poster.naturalWidth <= 120 && poster.dataset.fallback) {
        poster.src = poster.dataset.fallback;
      }
    };
    if (poster?.complete) useFallback();
    else poster?.addEventListener("load", useFallback, { once: true });

    holder.querySelector(".film-play")?.addEventListener("click", () => {
      const src = holder.dataset.embed;
      if (!src) return;
      for (const other of playing) pause(other);
      const frame = document.createElement("iframe");
      frame.src = src;
      frame.dataset.host = holder.dataset.host ?? "youtube";
      frame.title =
        holder.closest(".film")?.querySelector("h2")?.textContent?.trim() ?? "Film";
      frame.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      frame.allowFullscreen = true;
      holder.replaceChildren(frame);
      holder.classList.add("is-playing");
      playing.push(frame);
    });
  }
</script>
