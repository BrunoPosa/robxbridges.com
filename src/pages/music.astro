---
// Releases come from references/links.md. One heading there is one card here.
// A release with two or more tracks lists them. A single does not.
// The large cover is the release that is playing. Bandcamp is only the play bar.
import Base from "../layouts/Base.astro";
import { loadCatalog, publicSrc, type Album } from "../data/catalog";

const catalog = loadCatalog();
const { music } = catalog;
const albums = music.albums;
const playing = albums[0];
const playerTail =
  "/size=small/bgcol=080706/linkcol=ece7dc/tracklist=false/artwork=none/transparent=true/";

function playerSrc(album: Album): string {
  const id =
    album.kind === "track" ? `track=${album.playerId}` : `album=${album.playerId}`;
  return `https://bandcamp.com/EmbeddedPlayer/${id}${playerTail}`;
}
---

<Base title="Music">
  <article class="album-page">
    <h1>Music</h1>
    {playing && (
      <div class="album">
        <a
          class="album-cover-link"
          href={playing.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="album-cover"
            src={publicSrc(playing.cover)}
            alt={`${playing.title} cover`}
            width="1200"
            height="1200"
          />
        </a>
        <div class="release-list" data-player-tail={playerTail}>
          {albums.map((album, albumIndex) => {
            const active = albumIndex === 0;
            return (
              <div
                class:list={["player-card", { "is-playing": active }]}
                data-kind={album.kind}
                data-player={album.playerId}
                data-cover={publicSrc(album.cover)}
                data-url={album.url}
                data-title={album.title}
              >
                <div
                  class:list={[
                    "player-row",
                    { "player-row-single": album.tracks.length < 2 },
                  ]}
                >
                  <img
                    class="player-thumb"
                    src={publicSrc(album.cover)}
                    alt=""
                    width="120"
                    height="120"
                    loading={albumIndex === 0 ? "eager" : "lazy"}
                  />
                  {album.tracks.length > 1 && (
                    <ol class="track-list">
                      {album.tracks.map((track, index) => (
                        <li>
                          <button type="button" data-track={track.playerId}>
                            <span class="num">{index + 1}</span>
                            <span class="name">{track.title}</span>
                          </button>
                          {track.url && (
                            <a
                              class="video"
                              href={track.url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Video
                            </a>
                          )}
                        </li>
                      ))}
                    </ol>
                  )}
                </div>
                <p class="player-album">
                  <a href={album.url} target="_blank" rel="noopener noreferrer">
                    {album.title}
                  </a>
                  <span class="player-by"> · {album.credit ?? catalog.site.name}</span>
                </p>
                <button type="button" class="play-release" hidden={active}>
                  Play
                </button>
                {active && (
                  <iframe
                    class="player"
                    title={`${album.title} on Bandcamp`}
                    src={playerSrc(album)}
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>
    )}
  </article>
</Base>

<script>
  const coverLink = document.querySelector(".album-cover-link");
  const coverImg = document.querySelector(".album-cover");
  const playerTail =
    document.querySelector(".release-list")?.getAttribute("data-player-tail") ?? "";

  function embedSrc(kind: string, playerId: string, trackId?: string): string {
    const head = "https://bandcamp.com/EmbeddedPlayer/";
    if (kind === "track") return `${head}track=${playerId}${playerTail}`;
    const track = trackId ? `/track=${trackId}` : "";
    return `${head}album=${playerId}${track}${playerTail}`;
  }

  function play(card: HTMLElement, trackId?: string): void {
    if (!(coverLink instanceof HTMLAnchorElement)) return;
    if (!(coverImg instanceof HTMLImageElement)) return;
    const kind = card.dataset.kind || "album";
    const playerId = card.dataset.player || "";
    const title = card.dataset.title || "";
    const url = card.dataset.url || "";
    const cover = card.dataset.cover || "";
    if (!playerId || !cover) return;

    for (const other of document.querySelectorAll(".player-card")) {
      other.classList.remove("is-playing");
      const frame = other.querySelector("iframe.player");
      if (frame) frame.remove();
      const button = other.querySelector(".play-release");
      if (button instanceof HTMLButtonElement) button.hidden = false;
    }
    for (const item of document.querySelectorAll(".track-list button")) {
      item.removeAttribute("aria-current");
    }

    card.classList.add("is-playing");
    const playButton = card.querySelector(".play-release");
    if (playButton instanceof HTMLButtonElement) playButton.hidden = true;
    const frame = document.createElement("iframe");
    frame.className = "player";
    frame.title = `${title} on Bandcamp`;
    frame.src = embedSrc(kind, playerId, trackId);
    card.append(frame);

    coverImg.src = cover;
    coverImg.alt = `${title} cover`;
    coverLink.href = url;

    if (!trackId) return;
    const current = card.querySelector(
      `.track-list button[data-track="${CSS.escape(trackId)}"]`,
    );
    if (current instanceof HTMLButtonElement)
      current.setAttribute("aria-current", "true");
  }

  for (const button of document.querySelectorAll(".play-release")) {
    button.addEventListener("click", () => {
      const card = button.closest(".player-card");
      if (card instanceof HTMLElement) play(card);
    });
  }
  for (const button of document.querySelectorAll(".track-list button[data-track]")) {
    button.addEventListener("click", () => {
      const card = button.closest(".player-card");
      const trackId = button.getAttribute("data-track");
      if (card instanceof HTMLElement && trackId) play(card, trackId);
    });
  }
</script>
