---
// Releases come from references/links.md. One heading there is one album here.
// The cover on the left is the release in view. The card on the right is
// Bandcamp's own player, so the first click starts the music and the timeline
// stays visible. The wheel, over this block, moves to the next release.
// The row of small covers under it shows every release, so it is clear there
// is more after the first. Small cover copies are made by scripts/make-thumbs.ts.
// Tracks with a YouTube link show a still under the player that opens the video.
import Base from "../layouts/Base.astro";
import VideoDialog from "../components/VideoDialog.astro";
import BandcampPlayer from "../components/BandcampPlayer.astro";
import { loadCatalog, publicSrc, slugify } from "../data/catalog";
import { playerView, type PlayerView } from "../data/bandcamp";

type ReleaseData = {
  title: string;
  // The address name, so /music#luna-ep opens LUNA EP.
  slug: string;
  url: string;
  cover: string;
  // Bandcamp's player for this release (src/data/bandcamp.ts).
  player: PlayerView;
  credit?: string;
  videos: { title: string; url: string; youtubeId: string }[];
};

const catalog = loadCatalog();
const albums = catalog.music.albums;

// Bandcamp is asked about every release at once, while the site is built.
const releases: ReleaseData[] = await Promise.all(
  albums.map(async (album) => {
    const player = await playerView(album.player);
    const videos = album.tracks.flatMap((track) =>
      track.url && track.youtubeId
        ? [{ title: track.title, url: track.url, youtubeId: track.youtubeId }]
        : [],
    );
    return {
      title: album.title,
      slug: slugify(album.title),
      url: album.url,
      cover: publicSrc(album.cover),
      player,
      ...(album.credit ? { credit: album.credit } : {}),
      videos,
    };
  }),
);

// The small copy of a cover, made by scripts/make-thumbs.ts.
function thumbSrc(cover: string): string {
  return cover.replace(/\/([^/]+)$/, "/thumbs/$1");
}

const releaseJson = JSON.stringify(releases).replace(/</g, "\\u003c");
const playing = releases[0];
---

<Base title="Music">
  <article class="album-page">
    <h1 class="visually-hidden">Music</h1>
    {playing && (
      <div
        class="album"
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Albums"
      >
        <div class="album-side">
          <h2 class="album-title">{playing.title}</h2>
          <div class="album-cover-frame">
            <img
              class="album-cover"
              src={playing.cover}
              alt={`${playing.title} cover`}
              width="800"
              height="800"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          {releases.length > 1 && (
            <nav class="shelf" aria-label="All releases">
              <div class="shelf-head">
                <button type="button" class="shelf-step" data-step="-1" disabled>
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path
                      d="M10.5 3.5 5.5 8l5 4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                  Previous
                </button>
                <p class="album-index">
                  <span class="album-index-current">01</span>
                  <span class="album-index-total">
                    {String(releases.length).padStart(2, "0")}
                  </span>
                </p>
                <button type="button" class="shelf-step" data-step="1">
                  Next
                  <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                    <path
                      d="M5.5 3.5 10.5 8l-5 4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.2"
                    />
                  </svg>
                </button>
              </div>
              <ol class="shelf-row is-start">
                {releases.map((release, index) => (
                  <li>
                    <button
                      type="button"
                      class="shelf-item"
                      data-index={index}
                      aria-current={index === 0 ? "true" : undefined}
                      title={release.title}
                    >
                      <img
                        src={thumbSrc(release.cover)}
                        alt={release.title}
                        width="160"
                        height="160"
                        loading="lazy"
                        decoding="async"
                      />
                    </button>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>
        <div class="album-panel">
          <p class="release-credit" hidden={!playing.credit}>
            {playing.credit}
          </p>
          <BandcampPlayer view={playing.player} />
          <ul class="release-videos" hidden></ul>
          <p class="album-live" aria-live="polite" />
        </div>
      </div>
    )}
  </article>
  <!-- One video card. The script copies it for each video on the release in view. -->
  <template id="video-card">
    <li>
      <button type="button" class="video-card">
        <span class="video-card-still">
          <img alt="" width="320" height="180" loading="lazy" decoding="async" />
          <span class="video-card-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12">
              <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
            </svg>
          </span>
        </span>
        <span class="video-card-title"></span>
      </button>
    </li>
  </template>
  <VideoDialog />
  <script type="application/json" id="release-data" set:html={releaseJson} />
</Base>

<script>
  import { findPlayer } from "../scripts/bandcamp-player";
  import type { PlayerView } from "../data/bandcamp";

  type ReleaseData = {
    title: string;
    slug: string;
    url: string;
    cover: string;
    player: PlayerView;
    credit?: string;
    videos: { title: string; url: string; youtubeId: string }[];
  };

  const album = document.querySelector(".album");
  const coverFrame = document.querySelector<HTMLElement>(".album-cover-frame");
  const albumTitle = document.querySelector(".album-title");
  const coverImg = document.querySelector(".album-cover");
  const indexLabel = document.querySelector(".album-index-current");
  const credit = document.querySelector(".release-credit");
  const videos = document.querySelector(".release-videos");
  const live = document.querySelector(".album-live");
  const shelfRow = document.querySelector(".shelf-row");
  const shelfItems = document.querySelectorAll<HTMLButtonElement>(".shelf-item");
  const shelfSteps = document.querySelectorAll<HTMLButtonElement>(".shelf-step");
  const player = findPlayer(document.querySelector(".player-frame"));
  const dataEl = document.getElementById("release-data");
  const releases: ReleaseData[] = dataEl?.textContent
    ? (JSON.parse(dataEl.textContent) as ReleaseData[])
    : [];

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const ready = new Set<string>();
  let index = 0;
  let announced = false;
  let fadeToken = 0;
  let carry = 0;
  let locked = false;
  let carryTimer = 0;

  function remember(src: string): void {
    if (src) ready.add(src);
  }

  function preload(at: number): void {
    const src = releases[at]?.cover;
    if (!src || ready.has(src)) return;
    const img = new Image();
    img.decoding = "async";
    img.onload = () => remember(src);
    img.src = src;
  }

  function setCover(src: string, alt: string): void {
    if (!(coverImg instanceof HTMLImageElement)) return;
    coverImg.alt = alt;
    if (coverImg.getAttribute("src") === src) return;

    const token = ++fadeToken;
    const showImage = () => {
      if (token !== fadeToken) return;
      if (reduceMotion) {
        coverImg.style.transition = "";
        coverImg.classList.remove("is-fading");
        coverImg.src = src;
        return;
      }
      coverImg.style.transition = "none";
      coverImg.classList.add("is-fading");
      coverImg.src = src;
      void coverImg.offsetWidth;
      coverImg.style.transition = "";
      coverImg.classList.remove("is-fading");
    };

    if (ready.has(src)) {
      showImage();
      return;
    }
    const incoming = new Image();
    incoming.decoding = "async";
    incoming.onload = () => {
      remember(src);
      showImage();
    };
    incoming.onerror = () => {
      if (token !== fadeToken) return;
      coverImg.style.transition = "";
      coverImg.classList.remove("is-fading");
      coverImg.src = src;
    };
    incoming.src = src;
  }

  function showVideos(items: ReleaseData["videos"]): void {
    if (!(videos instanceof HTMLElement)) return;
    videos.replaceChildren();
    videos.hidden = items.length === 0;
    // Copy the first card from the page, then change its video.
    const template = document.querySelector<HTMLTemplateElement>("#video-card");
    for (const video of items) {
      const card = template?.content.firstElementChild?.cloneNode(true);
      if (!(card instanceof HTMLElement)) return;
      const button = card.querySelector<HTMLButtonElement>(".video-card");
      const still = card.querySelector("img");
      const title = card.querySelector(".video-card-title");
      if (!button || !still || !title) return;
      button.dataset.dialogSrc = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?autoplay=1&rel=0&playsinline=1`;
      button.dataset.dialogTitle = video.title;
      button.dataset.dialogLink = video.url;
      still.src = `https://i.ytimg.com/vi/${video.youtubeId}/mqdefault.jpg`;
      title.textContent = video.title;
      videos.append(card);
    }
  }

  // The current cover in the row is lit, and the row slides so it sits in
  // the middle. Positions are measured against the row itself, because the
  // page margin around the row differs between a phone and a computer.
  function showShelf(at: number): void {
    shelfItems.forEach((item, itemIndex) => {
      if (itemIndex === at) item.setAttribute("aria-current", "true");
      else item.removeAttribute("aria-current");
    });
    const current = shelfItems[at];
    if (shelfRow instanceof HTMLElement && current) {
      const row = shelfRow.getBoundingClientRect();
      const item = current.getBoundingClientRect();
      const centre = shelfRow.scrollLeft + item.left - row.left + item.width / 2;
      const most = shelfRow.scrollWidth - shelfRow.clientWidth;
      const left = Math.min(most, Math.max(0, centre - shelfRow.clientWidth / 2));
      shelfRow.scrollTo({ left, behavior: reduceMotion ? "auto" : "smooth" });
    }
    for (const step of shelfSteps) {
      const target = at + Number(step.dataset.step);
      step.disabled = target < 0 || target >= releases.length;
    }
  }

  function show(next: number): void {
    if (next < 0 || next >= releases.length || next === index) return;
    index = next;
    const release = releases[next];
    if (!release) return;

    setCover(release.cover, `${release.title} cover`);
    if (albumTitle) albumTitle.textContent = release.title;
    player?.show(release.player);
    if (indexLabel) indexLabel.textContent = String(next + 1).padStart(2, "0");
    if (credit instanceof HTMLElement) {
      credit.textContent = release.credit ?? "";
      credit.hidden = !release.credit;
    }
    showVideos(release.videos);
    showShelf(next);
    preload(next - 1);
    preload(next + 1);
    if (live && announced) {
      live.textContent = `Album ${next + 1} of ${releases.length}, ${release.title}`;
    }
    announced = true;
  }

  // One flick moves one release. At the first and last release the page
  // scrolls again, so About and contact stay reachable.
  function onWheel(event: WheelEvent): void {
    if (!finePointer || event.ctrlKey) return;
    const vertical =
      event.deltaMode === 1
        ? event.deltaY * 16
        : event.deltaMode === 2
          ? event.deltaY * 120
          : event.deltaY;
    if (Math.abs(event.deltaX) > Math.abs(vertical)) return;
    const direction = vertical > 0 ? 1 : -1;
    if (index + direction < 0 || index + direction >= releases.length) return;
    event.preventDefault();
    window.clearTimeout(carryTimer);
    carryTimer = window.setTimeout(() => {
      carry = 0;
    }, 180);
    if (locked) return;
    carry += vertical;
    if (Math.abs(carry) < 48) return;
    carry = 0;
    locked = true;
    show(index + direction);
    window.setTimeout(() => {
      locked = false;
    }, 420);
  }

  if (album instanceof HTMLElement && releases.length > 0) {
    if (coverImg instanceof HTMLImageElement) {
      const initial = coverImg.getAttribute("src") || "";
      if (coverImg.complete && coverImg.naturalWidth > 0) remember(initial);
      else coverImg.addEventListener("load", () => remember(initial), { once: true });
    }
    preload(1);
    showVideos(releases[0]?.videos ?? []);

    // A link such as /music#luna-ep (from the About bio) opens that release
    // and brings it into view. /music#luna-ep-videos goes on to its video
    // stills, which sit far below the cover on a phone.
    const openFromAddress = () => {
      const hash = decodeURIComponent(location.hash.slice(1));
      const slug = hash.replace(/-videos$/, "");
      const at = releases.findIndex(
        (release) => release.slug === hash || release.slug === slug,
      );
      if (at < 0) return;
      show(at);
      const wantsVideos = hash !== releases[at]?.slug;
      const target =
        wantsVideos && videos instanceof HTMLElement && !videos.hidden
          ? videos
          : document.querySelector(".album-page");
      target?.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: target === videos ? "nearest" : "start",
      });
    };
    openFromAddress();
    window.addEventListener("hashchange", openFromAddress);

    // With a mouse or trackpad, scrolling over the big cover moves between
    // releases. Anywhere else, the page scrolls as usual.
    coverFrame?.addEventListener("wheel", onWheel, { passive: false });

    for (const item of shelfItems) {
      item.addEventListener("click", () => show(Number(item.dataset.index)));
    }
    for (const step of shelfSteps) {
      step.addEventListener("click", () => show(index + Number(step.dataset.step)));
    }

    // Fade an edge of the row only while more covers sit past it.
    if (shelfRow instanceof HTMLElement) {
      const updateFades = () => {
        const most = shelfRow.scrollWidth - shelfRow.clientWidth;
        shelfRow.classList.toggle("is-start", shelfRow.scrollLeft <= 1);
        shelfRow.classList.toggle("is-end", shelfRow.scrollLeft >= most - 1);
      };
      shelfRow.addEventListener("scroll", updateFades, { passive: true });
      window.addEventListener("resize", updateFades);
      updateFades();
    }

    album.addEventListener("keydown", (event) => {
      if (event.altKey || event.metaKey || event.ctrlKey) return;
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      show(index + (event.key === "ArrowRight" ? 1 : -1));
    });

    // A sideways swipe on the cover changes the release, the way photo
    // carousels work. The CSS rule `touch-action: pan-y` on the cover lets
    // the browser keep vertical scrolling and hand sideways moves to this
    // script. The cover follows the finger, and a release changes after a
    // fifth of the cover's width or a quick flick.
    if (coverFrame instanceof HTMLElement && coverImg instanceof HTMLImageElement) {
      let swipe: { x: number; time: number; pointerId: number; dx: number } | null =
        null;

      const release = (dx: number, commit: boolean) => {
        coverImg.style.transition = "";
        coverImg.style.transform = "";
        if (commit) show(index + (dx < 0 ? 1 : -1));
      };

      coverFrame.addEventListener("pointerdown", (event) => {
        if (event.pointerType !== "touch" || swipe) return;
        swipe = {
          x: event.clientX,
          time: event.timeStamp,
          pointerId: event.pointerId,
          dx: 0,
        };
        coverFrame.setPointerCapture(event.pointerId);
      });

      coverFrame.addEventListener("pointermove", (event) => {
        if (!swipe || swipe.pointerId !== event.pointerId) return;
        swipe.dx = event.clientX - swipe.x;
        if (reduceMotion) return;
        // Past the first or last release the cover only gives a little.
        const target = index + (swipe.dx < 0 ? 1 : -1);
        const atEdge = target < 0 || target >= releases.length;
        const shift = atEdge ? swipe.dx * 0.25 : swipe.dx;
        coverImg.style.transition = "none";
        coverImg.style.transform = `translateX(${shift}px)`;
      });

      coverFrame.addEventListener("pointerup", (event) => {
        if (!swipe || swipe.pointerId !== event.pointerId) return;
        const { dx } = swipe;
        const speed = Math.abs(dx) / Math.max(1, event.timeStamp - swipe.time);
        swipe = null;
        const far = Math.abs(dx) > coverFrame.clientWidth * 0.2;
        const flick = Math.abs(dx) > 24 && speed > 0.35;
        release(dx, far || flick);
      });

      // The browser took the gesture over (the finger moved up or down).
      coverFrame.addEventListener("pointercancel", () => {
        swipe = null;
        release(0, false);
      });
    }
  }
</script>
